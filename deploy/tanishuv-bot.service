[Unit]
Description=Tanishuv Telegram bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tanishuv
Group=tanishuv
WorkingDirectory=/opt/tanishuv
ExecStart=/opt/tanishuv/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tanishuv/data
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
